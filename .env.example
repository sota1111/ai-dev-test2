# Database URL for Prisma (SQLite)
DATABASE_URL=file:./dev.db

# App mode: set to 'production' for production-equivalent startup
# Next.js sets NODE_ENV automatically based on the startup command:
#   npm run dev    → development
#   npm start      → production
# Do not set NODE_ENV manually unless you have a specific reason.

# Port (used with docker or custom start scripts)
PORT=3000
